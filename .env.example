# Application
PROJECT_NAME="AI Rental Intelligence API"
SECRET_KEY="09d25e094faa6ca2556c818166b7a9563b93f7099f6f0f4caa6cf63b88e8d3e7"
PORT=8080

# Database (PostgreSQL)
DATABASE_URL=postgresql://user:password@localhost:5432/rental_intelligence

# LLM Providers
GROQ_API_KEY=
OPENAI_API_KEY=

# Embeddings (FastEmbed or OpenAI)
EMBEDDING_PROVIDER=fastembed
EMBEDDING_MODEL=BAAI/bge-small-en-v1.5
EMBEDDING_DIMENSIONS=384

# Vector DB (Qdrant)
VECTOR_DB_PROVIDER=qdrant
QDRANT_URL=http://qdrant:6333
QDRANT_API_KEY=
QDRANT_COLLECTION=rental_agreement_chunks_v2

# Retrieval & Reranker
DENSE_TOP_K=20
SPARSE_TOP_K=20
RERANK_TOP_K=8
RERANKER_PROVIDER=cohere
COHERE_API_KEY=
RERANKER_MODEL=

# Object Storage (S3 / MinIO / Cloudflare R2)
OBJECT_STORAGE_PROVIDER=minio
S3_ENDPOINT_URL=http://minio:9000
S3_ACCESS_KEY=admin
S3_SECRET_KEY=password
S3_BUCKET=rental-agreements
S3_REGION=us-east-1

# Redis
REDIS_URL=redis://redis:6379/0

# ClamAV Antivirus
CLAMAV_ENABLED=true
CLAMAV_HOST=clamav
CLAMAV_PORT=3310
CLAMAV_STRICT_MODE=false

